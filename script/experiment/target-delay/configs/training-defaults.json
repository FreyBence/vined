{
  "entry_arguments": {
    "seed": 42,
    "epochs": 50,
    "batch_size": 1,
    "validation_batch_size": 1,
    "learning_rate": 0.0002,
    "weight_decay": 0.01,
    "scheduler": "none",
    "eval_every": 1,
    "checkpoint_selection": "validation_loss",
    "num_sessions": 1,
    "no_wandb": true
  },
  "training_overrides": {
    "training": {
      "target_granularity": "region",
      "save_every": 5,
      "save_plot_every_n_epochs": 50
    },
    "optimizer": {
      "gradient_accumulation_steps": 4
    },
    "model": {
      "encoder": {
        "embedder": {
          "dropout": 0.1
        },
        "transformer": {
          "n_layers": 2,
          "hidden_size": 128,
          "n_heads": 4,
          "inter_size": 256,
          "dropout": 0.1
        }
      }
    }
  }
}
