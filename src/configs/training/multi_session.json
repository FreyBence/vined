{
  "seed": 42,
  "wandb": {
    "use": true,
    "entity": null,
    "project": "NEDS"
  },
  "training": {
    "objective": "encoding",
    "mixed_training": false,
    "enc_task_var": "all",
    "checkpoint_selection": "validation_metric",
    "selection_metric": "eval_avg_metric",
    "selection_direction": "max",
    "validation_metrics": [
      "bps",
      "cosine_similarity"
    ],
    "loss_components": {
      "spike": {
        "name": "poisson_nll",
        "weight": 1.0
      },
      "vision-clip": {
        "name": "cosine",
        "weight": 1.0
      }
    },
    "num_epochs": 100,
    "train_batch_size": 8,
    "test_batch_size": 8,
    "save_plot_every_n_epochs": 10,
    "save_every": 10,
    "eval_every": 1
  },
  "data": {
    "max_time_length": 100,
    "load_meta": true
  },
  "optimizer": {
    "name": "adamw",
    "gradient_accumulation_steps": 1,
    "lr": 0.0002,
    "wd": 0.01,
    "eps": 1e-08,
    "warmup_pct": 0.15,
    "div_factor": 10,
    "scheduler": "cosine"
  },
  "masking": {
    "force_active": true,
    "mode": "temporal",
    "ratio": 0.3,
    "zero_ratio": 1.0,
    "random_ratio": 1.0,
    "expand_prob": 0.0,
    "max_timespan": 1,
    "channels": null,
    "timesteps": null,
    "mask_regions": [
      "all"
    ],
    "target_regions": [
      "all"
    ],
    "n_mask_regions": 1,
    "causal_zero": true
  }
}
