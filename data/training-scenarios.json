{
  "schema_version": "1.2.0",
  "registry_type": "training_scenarios",
  "scenario_argument": {
    "name": "scenario",
    "type": "integer",
    "lookup": "scenarios[str(scenario)]"
  },
  "fixed_sources": {
    "vision_clip": {
      "source": "precomputed_clip_features",
      "extractor": "existing_clip_extraction",
      "modifiable_by_scenario": false,
      "embedding_dim": 768,
      "requires_timestamps": true
    },
    "neural_spikes": {
      "source": "extracted_neural_spike_data",
      "extractor": "existing_neural_data_extraction",
      "modifiable_by_scenario": false,
      "requires_timestamps": true,
      "requirement": "Must preserve sufficient temporal information for scenario-defined 60 Hz binning."
    }
  },
  "available_modalities": {
    "vision_clip": {
      "status": "available",
      "kind": "continuous_feature_sequence"
    },
    "neural_spikes": {
      "status": "available",
      "kind": "neural_sequence"
    }
  },
  "supported_prediction_tasks": {
    "encoding": {
      "direction": "vision_to_neural",
      "inputs": [
        "vision_clip"
      ],
      "targets": [
        "neural_spikes"
      ]
    },
    "decoding": {
      "direction": "neural_to_vision",
      "inputs": [
        "neural_spikes"
      ],
      "targets": [
        "vision_clip"
      ]
    }
  },
  "masking_capabilities": {
    "configuration_shape": {
      "mask_type": "single value",
      "mask_mode": "list; supports one or more masking modes when implemented by the model",
      "mask_ratio": "float in [0, 1]",
      "use_mtm": "boolean"
    },
    "currently_verified": {
      "mask_type": [
        "embd"
      ],
      "mask_mode": [
        "temporal"
      ]
    }
  },
  "comparison_groups": {
    "encoding_temporal_context_60hz": {
      "scenario_ids": [
        1,
        2,
        3,
        4,
        5
      ],
      "independent_variable": "representation.temporal_context.context_bins",
      "controlled": [
        "fixed input/target extraction",
        "60 Hz alignment",
        "model architecture",
        "training hyperparameters",
        "masking configuration",
        "train/validation/test split",
        "evaluation target positions"
      ]
    },
    "decoding_temporal_context_60hz": {
      "scenario_ids": [
        6,
        7,
        8,
        9,
        10
      ],
      "independent_variable": "representation.temporal_context.context_bins",
      "controlled": [
        "fixed input/target extraction",
        "60 Hz alignment",
        "model architecture",
        "training hyperparameters",
        "masking configuration",
        "train/validation/test split",
        "evaluation target positions"
      ]
    },
    "neural_region_selection_ablation": {
      "status": "template",
      "axis": "neural_region_selection",
      "values": [
        "all_recorded",
        "visual_only"
      ],
      "require_same": [
        "prediction_direction",
        "temporal_context",
        "sampling_frequency_hz",
        "alignment",
        "model_architecture",
        "training_hyperparameters",
        "masking_configuration",
        "train_validation_test_split"
      ],
      "evaluation_constraints": {
        "encoding": "Evaluate both variants on the same visual-region target units.",
        "decoding": "Evaluate both variants against the same vision_clip targets and target time positions."
      },
      "notes": "Create concrete paired scenarios only when the temporal-context configuration to be held fixed for this ablation has been selected."
    }
  },
  "scenarios": {
    "1": {
      "id": 1,
      "name": "S1_encoding_60Hz_1bin",
      "status": "active",
      "prediction": {
        "task": "encoding",
        "model_mode": "encoding",
        "direction": "vision_to_neural",
        "input_modalities": [
          "vision_clip"
        ],
        "target_modalities": [
          "neural_spikes"
        ]
      },
      "data": {
        "inputs": [
          "vision_clip"
        ],
        "targets": [
          "neural_spikes"
        ]
      },
      "alignment": {
        "sampling_frequency_hz": 60.0,
        "bin_size_ms": 16.6666667,
        "time_reference": "session_time",
        "interval_convention": "[t_i, t_{i+1})",
        "visual_state_semantics": "visual state sampled at t_i is valid on [t_i, t_{i+1})",
        "neural_bin_semantics": "spikes are aggregated on [t_i, t_{i+1})",
        "base_index_pairing": "vision_clip[i] and neural_spikes[i] share the same physical interval",
        "gap_policy": {
          "visual_gap": "invalid",
          "zero_spike_bin": "valid"
        }
      },
      "representation": {
        "vision": {
          "type": "clip_embedding_sequence",
          "embedding_dim": 768
        },
        "neural": {
          "type": "spike_count_per_bin"
        },
        "temporal_context": {
          "context_modality": "vision_clip",
          "context_bins": 1,
          "context_ms": 16.6666667,
          "relative_to_target": "past_and_current",
          "offsets_in_bins": {
            "start_bins": 0,
            "end_bins": 0
          },
          "include_target_interval": true,
          "notes": "Predict neural activity from the current and preceding visual states. Future visual states relative to the neural target are forbidden."
        }
      },
      "model": {
        "mode": "encoding",
        "temporal_context_bins": 1
      },
      "training": {
        "seed": 42,
        "batch_size": null,
        "epochs": null,
        "optimizer": null,
        "learning_rate": null,
        "loss": null,
        "masking": {
          "enabled": true,
          "mask_type": "embd",
          "mask_mode": [
            "temporal"
          ],
          "mask_ratio": 0.1,
          "use_mtm": false
        }
      },
      "evaluation": {
        "comparison_group": "encoding_temporal_context_60hz",
        "common_target_policy": "evaluate only target positions valid for every scenario in the comparison group",
        "metrics": {
          "primary": [
            "bits_per_spike_or_poisson_deviance"
          ],
          "secondary": [
            "correlation",
            "r2"
          ]
        },
        "report_per_brain_region": true,
        "report_per_session": true
      },
      "axes": {
        "prediction_direction": "encoding",
        "temporal_context": 1,
        "neural_region_selection": "all_recorded"
      },
      "neural_region_selection": {
        "mode": "all_recorded",
        "region_set": null
      }
    },
