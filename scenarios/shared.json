{
  "schema_version": "1.2.0",
  "registry_type": "training_scenarios",
  "scenario_argument": {
    "name": "scenario",
    "type": "integer",
    "lookup": "scenarios/<scenario>.json"
  },
  "fixed_sources": {
    "vision_clip": {
      "source": "precomputed_clip_features",
      "extractor": "existing_clip_extraction",
      "modifiable_by_scenario": false,
      "embedding_dim": 768,
      "requires_timestamps": true
    },
    "neural_spikes": {
      "source": "extracted_neural_spike_data",
      "extractor": "existing_neural_data_extraction",
      "modifiable_by_scenario": false,
      "requires_timestamps": true,
      "requirement": "Must preserve sufficient temporal information for scenario-defined 60 Hz binning."
    }
  },
  "available_modalities": {
    "vision_clip": {
      "status": "available",
      "kind": "continuous_feature_sequence"
    },
    "neural_spikes": {
      "status": "available",
      "kind": "neural_sequence"
    }
  },
  "supported_prediction_tasks": {
    "encoding": {
      "direction": "vision_to_neural",
      "inputs": [
        "vision_clip"
      ],
      "targets": [
        "neural_spikes"
      ]
    },
    "decoding": {
      "direction": "neural_to_vision",
      "inputs": [
        "neural_spikes"
      ],
      "targets": [
        "vision_clip"
      ]
    }
  },
  "masking_capabilities": {
    "configuration_shape": {
      "mask_type": "single value",
      "mask_mode": "list; supports one or more masking modes when implemented by the model",
      "mask_ratio": "float in [0, 1]",
      "use_mtm": "boolean"
    },
    "currently_verified": {
      "mask_type": [
        "embd"
      ],
      "mask_mode": [
        "temporal"
      ]
    }
  },
  "comparison_groups": {
    "encoding_temporal_context_60hz": {
      "scenario_ids": [
        1,
        2,
        3,
        4,
        5
      ],
      "independent_variable": "representation.temporal_context.context_bins",
      "controlled": [
        "fixed input/target extraction",
        "60 Hz alignment",
        "model architecture",
        "training hyperparameters",
        "masking configuration",
        "train/validation/test split",
        "evaluation target positions"
      ]
    },
    "decoding_temporal_context_60hz": {
      "scenario_ids": [
        6,
        7,
        8,
        9,
        10
      ],
      "independent_variable": "representation.temporal_context.context_bins",
      "controlled": [
        "fixed input/target extraction",
        "60 Hz alignment",
        "model architecture",
        "training hyperparameters",
        "masking configuration",
        "train/validation/test split",
        "evaluation target positions"
      ]
    },
    "neural_region_selection_ablation": {
      "status": "template",
      "axis": "neural_region_selection",
      "values": [
        "all_recorded",
        "visual_only"
      ],
      "require_same": [
        "prediction_direction",
        "temporal_context",
        "sampling_frequency_hz",
        "alignment",
        "model_architecture",
        "training_hyperparameters",
        "masking_configuration",
        "train_validation_test_split"
      ],
      "evaluation_constraints": {
        "encoding": "Evaluate both variants on the same visual-region target units.",
        "decoding": "Evaluate both variants against the same vision_clip targets and target time positions."
      },
      "notes": "Create concrete paired scenarios only when the temporal-context configuration to be held fixed for this ablation has been selected."
    }
  },
  "experimental_axes": {
    "prediction_direction": {
      "description": "Direction of prediction between visual and neural modalities.",
      "values": {
        "encoding": {
          "input_modalities": [
            "vision_clip"
          ],
          "target_modalities": [
            "neural_spikes"
          ]
        },
        "decoding": {
          "input_modalities": [
            "neural_spikes"
          ],
          "target_modalities": [
            "vision_clip"
          ]
        }
      }
    },
    "temporal_context": {
      "description": "Amount of temporally related input context available to the model.",
      "unit": "bins",
      "sampling_frequency_hz": 60.0,
      "values": [
        1,
        3,
        6,
        9,
        12
      ]
    },
    "neural_region_selection": {
      "description": "Controls which recorded neural regions are exposed to the model. This axis is independent of prediction direction and temporal context.",
      "values": {
        "all_recorded": {
          "description": "Use all recorded neural units from each selected session.",
          "region_filter": {
            "mode": "all_recorded"
          }
        },
        "visual_only": {
          "description": "Use only neural units whose anatomical region belongs to the shared visual-relevance region set used by session relevance filtering.",
          "region_filter": {
            "mode": "include_region_set",
            "region_set": "visual_relevance_regions"
          }
        }
      },
      "comparison_rule": {
        "encoding": "Compare both variants on the same visual-region neural target units. The all_recorded variant may train on additional neural targets.",
        "decoding": "Use identical vision_clip targets and target time positions; only the available neural input regions may differ."
      }
    }
  }
}
